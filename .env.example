# Public Supabase values only (Project Settings -> API). Copy to .env.local for
# local dev; for GitHub Pages set the same names as repository secrets/variables.
# Never put a service-role key or the trip invite code here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
